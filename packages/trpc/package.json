    },
    "./transcript": {
      "types": "./src/transcript.ts",
      "default": "./src/transcript.ts"
    },
    "./video-upload": {
      "types": "./src/video-upload.ts",
      "default": "./src/video-upload.ts"
    },
    "./chat": {
      "types": "./src/chat.ts",
      "default": "./src/chat.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./router": {
      "types": "./src/router.ts",
      "default": "./src/router.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./course-invitations": {
      "types": "./src/course-invitations.ts",
