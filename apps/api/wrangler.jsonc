/**
 * VideoQ backend on Cloudflare Workers (Hono).
 * Native API runtime:
 *   - Hono ルーター + 共通ミドルウェア（requestId / logger / CORS / error handler）
 *   - /health（liveness） /ready（DB 疎通）
 *   - クラウド本番は D1 / Vectorize、ローカルは PostgreSQL
 *   - R2 バインディング
 *   - 未定義パスは統一された 404
 *
 * Deploy production: `npm run deploy` → `--env production`
 * Local: top-level vars + hyperdrive.localConnectionString / `.dev.vars`
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 本番は `env.production` の `videoq-api`。名前を分けておかないと
  // `--env production` を付け忘れた `wrangler deploy` が本番を上書きする。
  "name": "videoq-api-dev",
  // このトップレベル設定は `wrangler dev` 専用。`--env production` を付け忘れた
  // deploy が公開URLを持たないよう workers.dev を閉じる。ENVIRONMENT が
  // "development" のまま到達可能になると、テスト用認証ヘッダの経路が開く。
  "workers_dev": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },

  "ai": { "binding": "AI" },

  "vars": {
    "ENVIRONMENT": "development",
    "USE_S3_STORAGE": "true",
    "CORS_ALLOW_ORIGIN": "http://localhost,http://127.0.0.1,http://127.0.0.1:3000,http://localhost:3000",
    "FRONTEND_URL": "http://localhost",
    "DEFAULT_FROM_EMAIL": "noreply@videoq.local",
    "COURSE_INVITATION_BATCH_LIMIT": "50",
    "MAX_VIDEO_UPLOAD_SIZE_MB": "200",
    "DEFAULT_STORAGE_LIMIT_GB": "1",
    "DEFAULT_PROCESSING_LIMIT_MINUTES": "45",
    "DEFAULT_AI_ANSWERS_LIMIT": "30",
    "STRIPE_AUTOMATIC_TAX": "false",
    // Chat, summaries and vision share Workers AI; embeddings keep OpenRouter.
    "OPENAI_BASE_URL": "https://openrouter.ai/api/v1",
    "EMBEDDING_MODEL": "openai/text-embedding-3-small",
    "LLM_MODEL": "@cf/google/gemma-4-26b-a4b-it",

    "LLM_MAX_TOKENS": "4096",
    "LLM_SEPARATE_TOOL_SCHEMA": "true",
    "LLM_PRESERVE_TOOL_REASONING": "true",
    "VIDEO_VISUAL_ENABLED": "true",
    "PGVECTOR_COLLECTION_NAME": "scene_embeddings",
    "OAUTH_ISSUER_URL": "http://localhost",
    "BETTER_AUTH_URL": "http://localhost"
  },

  // `wrangler dev` は localConnectionString しか見ない。id に本番の Hyperdrive を
  // 書くと、`--env production` を付け忘れた deploy が本番DBに繋がってしまうため、
  // ここには存在しない id を置く。本番の id は env.production 側にだけ書く。
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgresql://postgres:postgres@localhost:55432/postgres"
    }
  ],

  "r2_buckets": [
    {
      "binding": "VIDEO_BUCKET",
      "bucket_name": "videoq-media",
      "preview_bucket_name": "videoq-media-preview"
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
      { "name": "TASK_SCHEDULER", "class_name": "TaskScheduler" },
      { "name": "CHAT_EXECUTION", "class_name": "ChatExecution" }
    ]
  },
  "migrations": [
    { "tag": "v1-rate-limiter", "new_sqlite_classes": ["RateLimiter"] },
    { "tag": "v2-study-session", "new_sqlite_classes": ["StudySession"] },
    { "tag": "v3-task-scheduler", "new_sqlite_classes": ["TaskScheduler"] },
    { "tag": "v4-remove-study-session", "deleted_classes": ["StudySession"] },
    { "tag": "v5-chat-execution", "new_sqlite_classes": ["ChatExecution"] }
  ],

  // 回復処理のポーリング cron は TASK_SCHEDULER（DO アラーム）へ移した。
  // 5分間隔だと Neon の自動サスペンド（無操作5分）に一度も入れず、
  // 処理対象ゼロでも compute が常時課金され続ける。残すのは日次の保持期間掃除
  // だけで、これがアラームを張り損ねた対象を拾う最終防衛線も兼ねる。
  "triggers": {
    "crons": ["17 3 * * *"]
  },

  "env": {
    "production": {
      "name": "videoq-api",
      // 公開経路は下の routes だけ。workers.dev を開けると CORS も
      // Cookie ドメインも効かない第二の入口ができてしまう。
      "workers_dev": false,
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "head_sampling_rate": 1 },
        "traces": { "enabled": true, "head_sampling_rate": 0.05 }
      },
      "ai": { "binding": "AI" },
      "vars": {
        "ENVIRONMENT": "production",
        "DEPLOYMENT_EDITION": "cloud",
        "PERSISTENCE_BACKEND": "d1",
        "MIGRATION_TRAFFIC_STATE": "running",
        "USE_S3_STORAGE": "true",
        "CORS_ALLOW_ORIGIN": "https://videoq.jp",
        "FRONTEND_URL": "https://videoq.jp",
        "DEFAULT_FROM_EMAIL": "noreply@mg.videoq.jp",
        "MAILGUN_SENDER_DOMAIN": "mg.videoq.jp",
        "COURSE_INVITATION_BATCH_LIMIT": "50",
        "MAX_VIDEO_UPLOAD_SIZE_MB": "200",
        "DEFAULT_STORAGE_LIMIT_GB": "1",
        "DEFAULT_PROCESSING_LIMIT_MINUTES": "45",
        "DEFAULT_AI_ANSWERS_LIMIT": "30",
        "STRIPE_AUTOMATIC_TAX": "false",
        // Workers AI chat/vision is independent of the media worker and embeddings.
        "OPENAI_BASE_URL": "https://openrouter.ai/api/v1",
        "OPENROUTER_FEDERATION_POLICY_ID": "c333bd7c-880a-437c-9fc9-e5825716325e",
        "OPENROUTER_FEDERATION_AUDIENCE": "https://openrouter.ai",
        "AWS_REGION": "ap-northeast-1",
        "EMBEDDING_PROVIDER": "workers-ai",
        "EMBEDDING_PROFILE": "embeddinggemma2",
        "EMBEDDING_MODEL": "@cf/google/embeddinggemma-2",
        "LLM_MODEL": "@cf/google/gemma-4-26b-a4b-it",

        "LLM_MAX_TOKENS": "4096",
        "LLM_SEPARATE_TOOL_SCHEMA": "true",
        "LLM_PRESERVE_TOOL_REASONING": "true",
        "VIDEO_VISUAL_ENABLED": "true",
        "OAUTH_ISSUER_URL": "https://videoq.jp",
        "BETTER_AUTH_URL": "https://videoq.jp",
        "R2_BUCKET_NAME": "videoq-media-prod",
        "R2_S3_ENDPOINT": "https://12daec56fdba43f677f2766ee26a5a39.r2.cloudflarestorage.com",
        "R2_S3_REGION": "auto"
      },
      "routes": [
        { "pattern": "videoq.jp/api/*", "zone_name": "videoq.jp" },
        { "pattern": "videoq.jp/internal/worker/*", "zone_name": "videoq.jp" },
        { "pattern": "videoq.jp/.well-known/*", "zone_name": "videoq.jp" },
        { "pattern": "videoq.jp/health", "zone_name": "videoq.jp" },
        { "pattern": "videoq.jp/ready", "zone_name": "videoq.jp" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "videoq-prod-db",
          "database_id": "587bd210-6d9d-4f32-abb7-a490013e65d3",
          "migrations_dir": "drizzle-d1"
        }
      ],
      "vectorize": [
        { "binding": "SCENE_VECTORIZE_768", "index_name": "videoq-prod-scenes-embeddinggemma2-768" }
      ],
      "r2_buckets": [
        {
          "binding": "VIDEO_BUCKET",
          "bucket_name": "videoq-media-prod"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
          { "name": "TASK_SCHEDULER", "class_name": "TaskScheduler" },
          { "name": "CHAT_EXECUTION", "class_name": "ChatExecution" }
        ]
      },
      "triggers": {
        "crons": ["17 3 * * *"]
      }
    }
  }
}
