{
  "name": "@videoq/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify --env production",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.d1-tools.json",
    "test": "vitest run && npm run test:workers",
    "test:unit": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --env-file .dev.vars.example",
    "cf-typegen:check": "wrangler types --env-interface CloudflareBindings --env-file .dev.vars.example --check",
    "cf:hyperdrive:show": "wrangler hyperdrive get d69ecb01a493415197e52552db2990f8",
    "cf:hyperdrive:disable-cache": "wrangler hyperdrive update d69ecb01a493415197e52552db2990f8 --caching-disabled",
    "cf:r2-cors:apply": "wrangler r2 bucket cors set videoq-media-prod --file r2-cors.production.json --force",
    "cf:r2-cors:list": "wrangler r2 bucket cors list videoq-media-prod",
    "db:check": "drizzle-kit check",
    "db:verify": "node scripts/check-migrations.mjs",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "sh scripts/db-migrate.sh",
    "db:stamp": "node scripts/stamp-baseline.mjs",
    "db:studio": "drizzle-kit studio",
    "user:password:local": "node scripts/reset-local-password.mjs",
    "user:admin": "node scripts/create-admin.mjs",
    "rate-limit:reset": "sh scripts/reset-rate-limit.sh",
    "openrouter:check": "tsx scripts/check-openrouter.ts",
    "embeddings:check": "tsx scripts/check-embeddings.ts",
    "demo:students": "tsx scripts/prepare-student-demo.ts",
    "build:node": "node scripts/build-node.mjs",
    "start:node": "node dist/node.mjs",
    "dev:node": "tsx src/runtime/node.ts",
    "lint": "eslint .",
    "db:d1:generate": "drizzle-kit generate --config drizzle.d1.config.ts",
    "db:d1:check": "drizzle-kit check --config drizzle.d1.config.ts",
    "test:persistence": "vitest run test/persistence",
    "db:d1:baseline": "tsx scripts/d1-baseline.ts",
    "db:d1:export": "tsx scripts/d1-export.ts",
    "db:d1:verify-archive": "tsx scripts/d1-verify-archive.ts",
    "db:d1:manifest": "tsx scripts/d1-migration-manifest.ts",
    "db:d1:manifest:check": "tsx scripts/d1-migration-manifest.ts --check",
    "db:d1:cutover-check": "tsx scripts/d1-cutover-check.ts",
    "db:d1:staging:smoke": "tsx scripts/d1-staging-smoke.ts",
    "db:d1:staging:migrate": "tsx scripts/d1-staging-migrate.ts",
    "db:d1:rehearsal:fixture": "tsx scripts/d1-rehearsal-fixture.ts",
    "db:d1:staging:recovery": "tsx scripts/d1-staging-recovery.ts",
    "db:d1:source-schema": "tsx scripts/d1-source-schema.ts",
    "db:d1:staging:evaluate-search": "tsx scripts/d1-staging-evaluate-search.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.15",
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@better-auth/oauth-provider": "^1.7.15",
    "@hono/mcp": "^0.3.5",
    "@hono/node-server": "^2.1.6",
    "@hono/trpc-server": "^0.4.2",
    "@langchain/cloudflare": "^1.1.0",
    "@langchain/core": "^1.3.2",
    "@langchain/langgraph": "^1.6.0",
    "@langchain/langgraph-checkpoint": "^1.2.2",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "@langchain/openai": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@trpc/server": "^11.22.1",
    "@videoq/trpc": "0.1.0",
    "@yukiharada1228/langchain-postgres": "^0.2.4",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "langchain": "^1.5.19",
    "langsmith": "0.11.6",
    "openai": "^7.43.0",
    "pg": "^8.23.1",
    "stripe": "^23.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.12",
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261101.0-beta",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0",
    "yaml": "^2.9.1",
    "@typescript/native": "npm:typescript@^7.0.2"
  }
}
