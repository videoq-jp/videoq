{
  "name": "@videoq/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:worker": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "cf-typegen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types worker/env.d.ts --env-interface WebEnv --include-runtime=false",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.storybook.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "test:worker": "node --test scripts/test-worker.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --project storybook",
    "ui:sync": "node scripts/sync-digital-agency-ui.mjs",
    "ui:check": "node scripts/sync-digital-agency-ui.mjs --dry-run"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.12",
    "@better-auth/oauth-provider": "^1.7.12",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.104.5",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "11.19.0",
    "@videoq/trpc": "0.1.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eventsource-parser": "4.1.2",
    "i18next": "^26.5.10",
    "katex": "^0.19.1",
    "lucide-react": "^1.61.0",
    "mediabunny": "^1.62.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "msw-storybook-addon": "^3.0.3",
    "parse5": "8.0.1",
    "playwright": "^1.64.1",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0"
  },
  "optionalDependencies": {
    "@esbuild/linux-arm64": "0.28.2",
    "@esbuild/linux-x64": "0.28.2",
    "@rollup/rollup-linux-arm64-gnu": "4.65.0",
    "@rollup/rollup-linux-arm64-musl": "4.65.0",
    "@rollup/rollup-linux-x64-gnu": "4.65.0",
    "@rollup/rollup-linux-x64-musl": "4.65.0",
    "@swc/core-linux-arm64-gnu": "1.16.20",
    "@swc/core-linux-arm64-musl": "1.16.20",
    "@swc/core-linux-x64-gnu": "1.16.20",
    "@swc/core-linux-x64-musl": "1.16.20",
    "@tailwindcss/oxide-linux-arm64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-arm64-musl": "4.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.3",
    "lightningcss-linux-arm64-gnu": "1.33.0",
    "lightningcss-linux-arm64-musl": "1.33.0",
    "lightningcss-linux-x64-gnu": "1.33.0",
    "lightningcss-linux-x64-musl": "1.33.0"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
