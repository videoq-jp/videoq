{
  "name": "@videoq/docs",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "predev": "npm run check:content",
    "dev": "docusaurus start --host 127.0.0.1 --port 3001 --no-open",
    "prebuild": "npm run test:content && npm run check:content && npm run check:mermaid",
    "build": "docusaurus build",
    "postbuild": "npm run check:build",
    "predeploy": "npm run check:build",
    "deploy": "wrangler deploy",
    "serve": "docusaurus serve --host 127.0.0.1 --port 3001 --no-open",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-public-content.mjs source",
    "check:mermaid": "node --experimental-import-meta-resolve scripts/check-mermaid-peer.mjs",
    "check:build": "node scripts/check-public-content.mjs build",
    "test:content": "node --test scripts/*.test.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "^3.0.1",
    "@mermaid-js/layout-elk": "0.1.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/node": "^26.6.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "wrangler": "^4.151.0",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
