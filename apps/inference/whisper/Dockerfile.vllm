# Immutable GPU runtime, built/scanned/attested from main 355f6a7a (run 43027815979, attempt 1).
# Refresh dependencies using Dockerfile.vllm-base and On-prem Runtime Base, then
# review a digest update here. Ordinary releases never depend on a live PPA.
FROM ghcr.io/videoq-jp/videoq-vllm@sha256:9dfbae8eed3f568926793b0c81640610c09096f894518ba7c46dac7fafe5eb7b
USER 0:0
COPY security /usr/share/videoq/security
COPY LICENSE /usr/share/licenses/videoq/LICENSE
RUN python3 /usr/share/videoq/security/verify_kernel_headers.py \
    && python3 /usr/share/videoq/security/verify_apt.py
ENV HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 VLLM_NO_USAGE_STATS=1 DO_NOT_TRACK=1 HOME=/tmp
USER 10001:10001
RUN python3 /usr/share/videoq/security/verify_inference_runtime.py
ENTRYPOINT ["vllm", "serve"]
