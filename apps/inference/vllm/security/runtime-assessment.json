      "vulnerabilities": [
        "CVE-2026-45447",
        "CVE-2026-84782"
      ],
      "origin": "openssl-unused-protocol",
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impactStatement": "CVE-2026-45447 requires OpenSSL PKCS7_verify processing of PKCS#7/S-MIME; CVE-2026-84782 requires DTLS handshake retransmission. The reviewed vLLM HTTP endpoints and uploaded-audio decoding do not implement either operation. Ordinary HTTP/HTTPS TLS is not DTLS or PKCS#7 verification. No arbitrary startup hooks or model Python code are allowed. This is not a claim that the OpenSSL package is patched.",
      "references": [
        "https://openssl-library.org/news/secadv/20260609.txt",
        "https://openssl-library.org/news/secadv/20260929.txt"
      ]
    },
