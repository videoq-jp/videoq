Screen { background: #fbfcfa; color: #182c3b; }
#brand { dock: top; height: 3; padding: 0 3; content-align: left middle; background: #ffffff; color: #3159dc; text-style: bold; border-bottom: solid #e2e7e8; }
#workspace { height: 1fr; }
#sidebar { width: 29; padding: 2; background: #eef2eb; }
.side-title { text-style: bold; margin-bottom: 1; }
#steps { margin-top: 2; color: #3159dc; text-style: bold; }
.model-note { margin-top: 3; color: #596775; }
#pages { width: 1fr; }
#settings, #review, #installing, #finished { padding: 1 3; }
.heading { text-style: bold; margin: 1 0; height: auto; }
.description { height: auto; margin-bottom: 1; }
.card { height: auto; padding: 1 2; margin-bottom: 1; background: #ffffff; border: round #a8b6be; }
.card-title { height: auto; text-style: bold; margin-bottom: 1; color: #182c3b; }
.muted { height: auto; color: #596775; }
.notice { height: auto; padding: 1 2; margin-bottom: 1; background: #eef2eb; border-left: thick #3159dc; }
Label { height: auto; }
Input { height: 3; background: #ffffff; border: solid #596775; margin-bottom: 1; color: #182c3b; }
Input:focus { border: double #3159dc; }
Input:disabled { color: #596775; background: #eef2eb; }
Select { margin-bottom: 1; }
SelectCurrent { background: #ffffff; color: #182c3b; border: solid #596775; }
Button { min-width: 18; margin: 0 1 1 0; background: #eef2eb; color: #182c3b; border: solid #596775; height: 3; }
Button.-primary { background: #3159dc; color: #ffffff; border: solid #3159dc; text-style: bold; }
Button:focus { border: double #8a5a00; text-style: bold; }
Button:hover { background: #e1e9ff; color: #182c3b; }
Button.-primary:hover { background: #2247bf; color: #ffffff; }
.actions { height: auto; margin-top: 1; }
.error { height: auto; color: #b81924; margin-bottom: 1; }
Collapsible { background: #ffffff; border: solid #a8b6be; margin-bottom: 1; padding: 0 1; }
#logs { height: 16; background: #142734; color: #f3f6f2; padding: 1; }
#current-stage { margin-top: 1; }
ProgressBar { margin: 1 0; }
Footer { background: #eef2eb; color: #182c3b; }
.compact #sidebar { display: none; }
.compact #settings, .compact #review, .compact #installing, .compact #finished { padding: 1; }
