{
  "name": "videoq",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/api",
    "apps/docs",
    "apps/demo-video",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @videoq/web",
    "dev:api": "npm run dev --workspace @videoq/api",
    "dev:docs": "npm run dev --workspace @videoq/docs --",
    "build:docs": "npm run build --workspace @videoq/docs --",
    "deploy:docs": "npm run build:docs && npm run deploy --workspace @videoq/docs --",
    "preview:docs": "npm run serve --workspace @videoq/docs --",
    "dev:web": "npm run dev --workspace @videoq/web",
    "deploy:web": "npm run build && npm run deploy --workspace @videoq/web",
    "storybook": "npm run storybook --workspace @videoq/web --",
    "build:storybook": "npm run build-storybook --workspace @videoq/web",
    "test:storybook": "npm run test:storybook --workspace @videoq/web --",
    "db:check": "npm run db:check --workspace @videoq/api",
    "db:verify": "npm run db:verify --workspace @videoq/api",
    "db:generate": "npm run db:generate --workspace @videoq/api --",
    "db:generate:custom": "npm run db:generate:custom --workspace @videoq/api --",
    "db:migrate": "npm run db:migrate --workspace @videoq/api",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspace @videoq/api && npm run test --workspace @videoq/web",
    "test:api": "npm run test --workspace @videoq/api",
    "test:web": "npm run test --workspace @videoq/web",
    "typecheck": "npm run typecheck --workspace @videoq/trpc && npm run typecheck --workspace @videoq/api && npm run typecheck --workspace @videoq/web && npm run typecheck --workspace @videoq/docs && npm run typecheck --workspace @videoq/demo-video",
    "test:lint": "node --test scripts/test-eslint.mjs"
  },
  "overrides": {
    "vitest": "^5.0.3",
    "@vitest/browser": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "serialize-javascript": "^7.1.4",
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "@docusaurus/core": {
      "tinypool": "^2.1.2"
    },
    "mermaid": {
      "katex": "^0.18.6"
    },
    "miniflare": {
      "sharp": "~0.35.5"
    },
    "postcss-selector-parser": "^7.1.6",
    "undici@7": "^7.30.1",
    "fast-uri": "3.1.9",
    "qs": "6.16.2",
    "zod": "^4.6.5",
    "typescript": "$typescript"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "undici": "^8.12.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.72.1",
    "globals": "^17.13.0",
    "eslint-plugin-react-hooks": "^7.1.1"
  },
  "packageManager": "npm@12.2.1"
}
