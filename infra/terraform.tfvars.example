# Sample VideoQ Terraform variables
#
# Usage:
#   cp terraform.tfvars.example terraform.tfvars
#   # Adjust values for the environment, then run `terraform plan` / `terraform apply`.
#
# terraform.tfvars is excluded by .gitignore; only this example is committed.
# Values can also be supplied through TF_VAR_<name> environment variables, as in CI.
#
# Note: Do not manage secrets such as the DB connection string, encryption keys, or R2
#       credentials with Terraform. After applying, register them in Secrets
#       Manager with the AWS CLI (see Step 4 in DEPLOY.md).

# --- Basic settings ----------------------------------------------------------

# AWS region in which to deploy resources.
aws_region = "ap-northeast-1"

# Environment name used to name every resource: videoq-*-<env_name>.
env_name = "prod"

# ECR container image tag referenced by Lambda.
# It normally remains "latest" after the image is pushed.
image_tag = "latest"

# --- Lambda tuning -----------------------------------------------------------

# Worker Lambda memory size in MB; ffmpeg and AI inference are memory intensive.
worker_lambda_memory_mb = 5120

# Worker Lambda timeout in seconds. Lambda's 15-minute maximum is 900 seconds.
worker_lambda_timeout_seconds = 900

# --- SQS settings ------------------------------------------------------------

# SQS visibility timeout in seconds.
# At least max(6 * worker_lambda_timeout_seconds, 900 + worker_lambda_timeout_seconds + 60).
# Covers throttling retries and expiry of a lease claimed late in a timed-out invocation.
# Failed messages can take this long to become available for retry.
sqs_visibility_timeout_seconds = 5400

# Maximum message receive count before routing to the DLQ.
sqs_max_receive_count = 5

# --- Operations monitoring --------------------------------------------------

# Supported CloudWatch Logs retention period for the worker Lambda.
lambda_log_retention_days = 30

# Optional SNS email subscriber for Lambda/SQS/DLQ alarms. AWS sends a
# confirmation email after the first apply.
# operations_alert_email = "alerts@videoq.jp"

# --- OpenAI project management -----------------------------------------------
# Manage OpenAI organization project governance, including allowed models and
# spend alerts, with Terraform. Management is enabled by default through
# manage_openai_project=true. Before applying, export the admin API key as
# OPENAI_ADMIN_KEY and, if needed, OPENAI_ORG_ID. CI reads OPENAI_ADMIN_KEY and
# OPENAI_SPEND_ALERT_EMAIL from GitHub Secrets; see DEPLOY.md.
# Note: The provider does not manage the runtime OPENAI_API_KEY. Continue issuing
#       that key manually from the dashboard and saving it in the Secrets Manager
#       app secret.
#
# Example overrides for a local apply:
# openai_spend_alert_email   = "alerts@videoq.jp"
# openai_spend_threshold_usd = 50
# openai_allowed_models = ["text-embedding-3-small", "gpt-4o-mini", "gpt-4.1-mini", "gpt-6-luna", "whisper-1"]
# manage_openai_project = false  # Use only to disable management temporarily.

# Visual Q&A caches are enabled by default (set false to opt out; match the API flag).
worker_visual_enabled = true

# --- OpenRouter workload identity --------------------------------------------
# Enable AWS outbound identity federation and register its issuer in OpenRouter first.
# Use the worker role's own OpenRouter inference policy (not the API principal's).
# CI reads repository/environment variables OPENROUTER_WORKER_FEDERATION_POLICY_ID
# and OPENROUTER_FEDERATION_AUDIENCE, using the same values for plan and apply.
# openrouter_federation_policy_id = "<worker-policy-id>"
# openrouter_federation_audience  = "https://openrouter.ai"

# Independent search/account consumers (media keeps worker_lambda_* settings).
worker_media_maximum_concurrency = 10
worker_groups = {
  search  = { memory_mb = 2048, timeout_seconds = 900, storage_mb = 512, maximum_concurrency = 4 }
  account = { memory_mb = 1024, timeout_seconds = 900, storage_mb = 512, maximum_concurrency = 2 }
}
