{
  "Comment": "AWS-only D1 maintenance; retained archives are outside the job lifecycle",
  "StartAt": "Operation",
  "TimeoutSeconds": 7200,
  "States": {
    "Operation": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.kind",
          "StringEquals": "migration",
          "Next": "Migrate"
        },
        {
          "Variable": "$.kind",
          "StringEquals": "smoke",
          "Next": "SmokeStandalone"
        },
        {
          "Variable": "$.kind",
          "StringEquals": "deploy",
          "Next": "Deploy"
        }
      ],
      "Default": "RetiredOperation"
    },
    "Migrate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::codebuild:startBuild.sync",
      "Parameters": {
        "ProjectName": "${project_migration}",
        "EnvironmentVariablesOverride": [
          {
            "Name": "MAINTENANCE_RUN_ID",
            "Value.$": "$.run_id",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "MAINTENANCE_STAGE",
            "Value": "migration",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "MAINTENANCE_KIND",
            "Value.$": "$.kind",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "MAINTENANCE_FORCE",
            "Value.$": "States.Format('{}', $.force)",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "MAINTENANCE_SOURCE_SHA",
            "Value.$": "$.source_sha",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "MAINTENANCE_WRITERS_STOPPED",
            "Value.$": "States.Format('{}', $.writers_stopped)",
            "Type": "PLAINTEXT"
          }
        ]
      },
      "ResultPath": null,
      "TimeoutSeconds": 1200,
      "Next": "Release"
    },
    "SmokeStandalone": {
      "Type": "Task",
      "Resource": "arn:aws:states:::codebuild:startBuild.sync",
      "Parameters": {
        "ProjectName": "${project_smoke}",
        "EnvironmentVariablesOverride": [
          {
            "Name": "MAINTENANCE_RUN_ID",
            "Value.$": "$.run_id",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "MAINTENANCE_STAGE",
            "Value": "smoke",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "MAINTENANCE_KIND",
            "Value.$": "$.kind",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "MAINTENANCE_FORCE",
            "Value.$": "States.Format('{}', $.force)",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "VERIFY_AI_ANSWERS",
            "Value.$": "States.Format('{}', $.verify_ai_answers)",
            "Type": "PLAINTEXT"
          }
        ]
      },
      "ResultPath": null,
      "TimeoutSeconds": 2700,
      "Next": "Release"
    },
    "Deploy": {
      "Type": "Task",
      "Resource": "arn:aws:states:::codebuild:startBuild.sync",
      "Parameters": {
        "ProjectName": "${project_deploy}",
        "EnvironmentVariablesOverride": [
          {
            "Name": "MAINTENANCE_RUN_ID",
            "Value.$": "$.run_id",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "MAINTENANCE_STAGE",
            "Value": "deploy",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "MAINTENANCE_KIND",
            "Value.$": "$.kind",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "MAINTENANCE_FORCE",
            "Value.$": "States.Format('{}', $.force)",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "MAINTENANCE_SOURCE_SHA",
            "Value.$": "$.source_sha",
            "Type": "PLAINTEXT"
          }
        ]
      },
      "ResultPath": null,
      "TimeoutSeconds": 2700,
      "Next": "SmokeStandalone"
    },
    "Release": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:deleteItem",
      "Parameters": {
        "TableName": "${table}",
        "Key": {
          "pk": {
            "S": "maintenance"
          }
        },
        "ConditionExpression": "execution_arn = :execution",
        "ExpressionAttributeValues": {
          ":execution": {
            "S.$": "$$.Execution.Id"
          }
        }
      },
      "ResultPath": null,
      "Next": "Success"
    },
    "Success": {
      "Type": "Succeed"
    },
    "RetiredOperation": {
      "Type": "Fail",
      "Error": "RETIRED_NEON_OPERATION"
    }
  }
}
