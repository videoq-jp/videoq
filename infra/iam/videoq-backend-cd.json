{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrAuth",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EcrPush",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage"
      ],
      "Resource": [
        "arn:aws:ecr:ap-northeast-1:<ACCOUNT_ID>:repository/videoq-api-prod",
        "arn:aws:ecr:ap-northeast-1:<ACCOUNT_ID>:repository/videoq-worker-prod"
      ]
    },
    {
      "Sid": "LambdaCodeDeploy",
      "Effect": "Allow",
      "Action": [
        "lambda:UpdateFunctionCode",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration"
      ],
      "Resource": [
        "arn:aws:lambda:ap-northeast-1:<ACCOUNT_ID>:function:videoq-api-prod",
        "arn:aws:lambda:ap-northeast-1:<ACCOUNT_ID>:function:videoq-worker-prod",
        "arn:aws:lambda:ap-northeast-1:<ACCOUNT_ID>:function:videoq-worker-search-prod",
        "arn:aws:lambda:ap-northeast-1:<ACCOUNT_ID>:function:videoq-worker-account-prod"
      ]
    }
  ]
}
